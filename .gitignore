# Local secrets and configuration
*.yaml
.env

# Unapproved or sensitive datasets/exports; keep only synthetic fixtures and blank templates
/data/raw/
/data/processed/
/data/private/
/data/*.jsonl
!/data/demo_jobs.jsonl
/data/*.csv
!/data/source_registry_template.csv

# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/